# ardupilot-raster-mission.service
#
# Autonomous ArduPilot POLYGON RASTER COVERAGE mission daemon.
#
# SEPARATE from, and must never run at the same time as, the senior
# ardupilot-mission.service (soft-bounce). Both daemons take the same
# advisory lock (/tmp/ardupilot_mission.lock) and both want the same FC
# serial port, so the second one to start exits instead of fighting for it.
#
# Install:  sudo cp ardupilot-raster-mission.service /etc/systemd/system/
#           sudo systemctl daemon-reload
#
# This unit is intentionally NOT enabled by default. Enable it only when the
# raster mission is the one that should come up at boot, and only after
# disabling the senior unit.

[Unit]
Description=Autonomous Ardupilot polygon raster coverage mission starter
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# time-sync.target: the Pi 5 has no battery-backed RTC, so it boots with a
# restored (stale) clock and systemd-timesyncd steps it forward on its first
# NTP contact.  On 2026-09-15 that step landed mid-hover and aborted the
# mission.  The timing logic is monotonic now and no longer cares, but ordering
# after time-sync.target also keeps mission log timestamps honest.
# Requires:  sudo systemctl enable systemd-time-wait-sync.service
# Advisory only: systemd will stop the senior unit if it is running when this
# one starts. It does not stop the senior unit being started again afterwards.
Conflicts=ardupilot-mission.service

# Never give up permanently.  The default (5 starts / 10s) can put the unit into
# a 'failed' state that survives until 'systemctl reset-failed' or a reboot -
# which is exactly the reboot-every-time this is meant to remove.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=aahswarm
WorkingDirectory=/home/aahswarm/ardupilotRasterFix
Environment=VIRTUAL_ENV=/home/aahswarm/px4_mavsdk_env
Environment=PATH=/home/aahswarm/px4_mavsdk_env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/aahswarm/ardupilotRasterFix/start_ardupilot_raster_mission.sh
# Restart=always, not on-failure.  The daemon's own loop already survives a lost
# link, a missing /dev/ttyACM*, and an FC power-cycle (it re-resolves the port
# every attempt), so any exit at all means something unexpected ended it - a
# clean exit(0) just as much as a crash.  on-failure ignores exit(0) and would
# leave the aircraft with no supervisor until someone noticed.
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
